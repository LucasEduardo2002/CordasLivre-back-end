generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL") // Adicione esta linha exatamente assim
}

enum StringType {
  VIOLAO
  GUITARRA
  CONTRABAIXO
  CAVAQUINHO
  VIOLA_CAIPIRA
  VIOLINO
}

model Product {
  id        Int        @id @default(autoincrement())
  mlId      String
  title     String
  price     Float
  ratingAvg Float?
  ratingCount Int      @default(0)
  thumbnail String
  permalink String
  rank      Int
  type      StringType @default(VIOLAO)

  @@index([type, rank])
  // Se quiser evitar duplicidade por categoria:
  // @@unique([mlId, type])
}