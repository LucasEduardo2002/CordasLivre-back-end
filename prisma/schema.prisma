generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StringType {
  VIOLAO
  GUITARRA
  CONTRABAIXO
  CAVAQUINHO
  VIOLA_CAIPIRA
  VIOLINO
}

enum MaintenanceAlertLevel {
  OK
  SOON
  DUE
  OVERDUE
}

model Product {
  id        Int        @id @default(autoincrement())
  mlId      String
  title     String
  price     Float
  ratingAvg Float?
  ratingCount Int      @default(0)
  thumbnail String
  permalink String
  rank      Int
  type      StringType @default(VIOLAO)

  @@index([type, rank])
  // Se quiser evitar duplicidade por categoria:
  // @@unique([mlId, type])
}

model DictionaryTerm {
  id          String   @id @default(uuid())
  term        String   // Ex: "Phosphor Bronze"
  category    String   // Ex: "Material", "Calibre", "Estrutura"
  shortDesc   String   // Descrição curta para aparecer num Tooltip
  fullDesc    String   // Texto completo para a página do Dicionário
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StringMaintenance {
  id                String                @id @default(uuid())
  userId            String?
  userEmail         String
  type              StringType            @default(VIOLAO)
  lastChangeDate    DateTime
  studyHoursPerWeek Int
  estimatedLifeDays Int
  nextAlertDate     DateTime
  alertLevel        MaintenanceAlertLevel @default(OK)
  alertMessage      String?
  affiliateUrl      String?
  lastNotifiedAt    DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([userEmail, type])
  @@index([nextAlertDate, alertLevel])
}